      "tier": "short",
      "text": "块表负责逻辑分页，物理 cell 由后端决定。",
      "max_prompt_tokens": 64,
      "n_prompt": 21
    },
    {
      "prompt_id": "short-008",
      "tier": "short",
      "text": "KV 显存占用随上下文长度线性增长。短请求不应被长请求饿死，这是公平性的底线。",
      "max_prompt_tokens": 64,
      "n_prompt": 38
